# BeautyLink configuration. Copy to .env.local and adjust. All values are optional.

# Public base URL used for shareable page links (e.g. https://beautylink.app).
# If unset, the URL is derived from the incoming request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode seeds "Amy Beauty Studio" and shows the "Explore the demo" button.
# Set to "false" in production to hide the shared demo account.
DEMO_MODE=true

# Prototype storage (SQLite file and uploaded images). Defaults shown.
# DATABASE_PATH=./data/beautylink.db
# UPLOAD_DIR=./data/uploads

# --- Future production setup (not used by the prototype yet) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose-to-the-browser
